{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/student-registration",
      "destination": "/contact-us.html"
    },
    {
      "source": "/student-registration/(.*)",
      "destination": "/contact-us.html"
    },
    {
      "source": "/courses",
      "destination": "/undergraduate-courses.html"
    }
  ]
}